# PostgreSQL connection
DATABASE_URL="postgresql://releasedate:releasedate@localhost:5432/releasedate"

# Signs admin session cookies. Use 32+ random characters, e.g. `openssl rand -hex 32`.
SESSION_SECRET="change-me-to-a-long-random-string-change-me"

# Default admin created by the seed (only if the user does not exist yet).
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="Admin@1405!"

# Session cookie "Secure" flag. Defaults to true in production; set false only for plain-HTTP hosting.
# COOKIE_SECURE="false"

# Postgres for integration/E2E tests (tables are truncated during tests).
# TEST_DATABASE_URL="postgresql://releasedate:releasedate@localhost:5432/releasedate_test"
