generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReleaseStatus {
  planned
  ready
  released
  cancelled
  blocked
}

enum ReleaseType {
  feature
  improvement
  infrastructure
  experiment
  product_launch
  ai_model
  back_office
  other
}

enum Team {
  backend
  frontend
  ai
  product
  design
  marketing
}

enum CalendarEventType {
  company_event
  milestone
  other
}

model AdminUser {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique
  displayName  String
  passwordHash String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  createdReleases Release[]               @relation("ReleaseCreatedBy")
  scheduleChanges ReleaseScheduleChange[] @relation("ScheduleChangedBy")

  @@map("admin_users")
}

model Release {
  id          String        @id @default(uuid()) @db.Uuid
  title       String
  description String?
  type        ReleaseType   @default(feature)
  status      ReleaseStatus @default(planned)
  /// Scheduled business date (Asia/Tehran), stored as a plain calendar date.
  currentDate DateTime      @map("current_release_date") @db.Date
  /// "Before" deadline: the release is due on or before currentDate rather than exactly on it.
  dueBefore   Boolean       @default(false)
  /// Actual release moment (UTC). Only set through the release workflow.
  releasedAt  DateTime?     @db.Timestamptz(3)
  cancelledAt DateTime?     @db.Timestamptz(3)
  createdById String?       @db.Uuid
  createdBy   AdminUser?    @relation("ReleaseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)

  teams           ReleaseTeam[]
  scheduleChanges ReleaseScheduleChange[]

  @@index([currentDate])
  @@map("releases")
}

model ReleaseTeam {
  releaseId String  @db.Uuid
  team      Team
  release   Release @relation(fields: [releaseId], references: [id], onDelete: Restrict)

  @@id([releaseId, team])
  @@map("release_teams")
}

/// Immutable: rows are only ever inserted. A database trigger rejects UPDATE and DELETE.
model ReleaseScheduleChange {
  id             String     @id @default(uuid()) @db.Uuid
  releaseId      String     @db.Uuid
  release        Release    @relation(fields: [releaseId], references: [id], onDelete: Restrict)
  previousDate   DateTime   @db.Date
  newDate        DateTime   @db.Date
  reason         String?
  changedById    String?    @db.Uuid
  changedBy      AdminUser? @relation("ScheduleChangedBy", fields: [changedById], references: [id], onDelete: Restrict)
  /// Free-text actor for changes that did not come from a logged-in admin (e.g. the initial migration).
  changedByLabel String?
  changedAt      DateTime   @default(now()) @db.Timestamptz(3)

  @@index([releaseId, changedAt])
  @@index([previousDate])
  @@map("release_schedule_history")
}

model Sprint {
  id         String    @id @default(uuid()) @db.Uuid
  number     Int       @unique
  name       String?
  startDate  DateTime  @db.Date
  endDate    DateTime  @db.Date
  archivedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  @@index([startDate])
  @@map("sprints")
}

model CalendarEvent {
  id          String            @id @default(uuid()) @db.Uuid
  title       String
  date        DateTime          @db.Date
  type        CalendarEventType @default(company_event)
  description String?
  archivedAt  DateTime?         @db.Timestamptz(3)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)

  @@index([date])
  @@map("calendar_events")
}

/// Iran official holidays. Weekends (Friday/Saturday) are computed, not stored.
model Holiday {
  id         String    @id @default(uuid()) @db.Uuid
  date       DateTime  @db.Date
  name       String
  archivedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  @@index([date])
  @@map("holidays")
}
